---
import LayoutMapas from '@layouts/LayoutMapas.astro';
import Scene from '@components/3d/core/Scene.jsx';
---

<LayoutMapas title="Plano Virtual 3D | Revalora">
  <main class="h-full w-full relative">
    <div class="absolute top-0 left-0 w-full h-full z-0">
      <Scene client:only="react" />
    </div>
    
    {/* Header flotante - Info */}
    <div class="absolute top-6 left-6 z-10 pointer-events-none hidden md:block">
      <h1 class="text-xl font-bold text-white drop-shadow-md">Plano 1200m²</h1>
      <p class="text-gray-300 text-xs drop-shadow-md">Visualización interactiva</p>
    </div>
  </main>
</LayoutMapas>
