---
import LayoutDS from '@layouts/LayoutDS.astro';
import { DSInput } from '@components/design_system/atoms/DSInput';
import { DemoContainer } from '@components/design_system/demo/DemoContainer';
---

<LayoutDS title="Input Component">
  <header class="mb-10 border-b border-gray-200 pb-6">
    <h1 class="text-3xl font-bold text-gray-900">Input</h1>
    <p class="text-lg text-gray-600 mt-2">
      Componente de entrada de texto base. Soporta todos los modos del sistema.
    </p>
  </header>

  <div class="space-y-12">
    
    <!-- Preview Mode -->
    <section>
      <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        Modo Preview
      </h2>
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <div class="grid grid-cols-2 gap-8">
          <div>
            <p class="text-sm text-gray-500 mb-4">
              Renderizado estático para vistas de solo lectura. Elimina bordes y sombras.
            </p>
            <pre class="bg-slate-900 text-slate-300 p-3 rounded text-xs overflow-x-auto"><code>{`<DSInput 
  mode="preview" 
  label="Nombre del Proyecto" 
  value="Revalora Circular 2026" 
/>`}</code></pre>
          </div>
          <div class="bg-gray-50 p-4 rounded border border-gray-100 flex items-center">
            <DSInput 
              client:visible 
              mode="preview" 
              label="Nombre del Proyecto" 
              value="Revalora Circular 2026" 
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Batch Mode -->
    <section>
      <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-purple-500"></span>
        Modo Batch (Formulario)
      </h2>
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <p class="text-sm text-gray-500 mb-4">
          Integración completa con <code>react-hook-form</code>. Validaciones y gestión de errores.
        </p>
        <DemoContainer client:visible mode="batch" />
      </div>
    </section>

    <!-- Live Mode -->
    <section>
      <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        Modo Live (Auto-guardado)
      </h2>
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <p class="text-sm text-gray-500 mb-4">
          Auto-guardado con debounce y feedback visual de estado.
        </p>
        <DemoContainer client:visible mode="live" />
      </div>
    </section>

    <!-- Props API -->
    <section>
      <h2 class="text-xl font-semibold mb-4">API Reference</h2>
      
      <div class="mb-8">
        <h3 class="text-lg font-medium text-gray-800 mb-3">Universal Props (Base)</h3>
        <p class="text-sm text-gray-500 mb-4">Propiedades comunes disponibles en todos los modos.</p>
        <div class="overflow-x-auto border border-gray-200 rounded-lg">
          <table class="w-full text-sm text-left text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
              <tr>
                <th class="px-6 py-3">Prop</th>
                <th class="px-6 py-3">Type</th>
                <th class="px-6 py-3">Default</th>
                <th class="px-6 py-3">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr class="bg-white">
                <td class="px-6 py-4 font-mono text-xs text-blue-600">mode</td>
                <td class="px-6 py-4 font-mono text-xs">FieldMode</td>
                <td class="px-6 py-4 text-gray-400">Required</td>
                <td class="px-6 py-4">Define el comportamiento: <code>'preview'</code>, <code>'batch'</code>, o <code>'live'</code>.</td>
              </tr>
              <tr class="bg-white">
                <td class="px-6 py-4 font-mono text-xs text-blue-600">label</td>
                <td class="px-6 py-4 font-mono text-xs">string</td>
                <td class="px-6 py-4">-</td>
                <td class="px-6 py-4">Etiqueta visible sobre el componente.</td>
              </tr>
              <tr class="bg-white">
                <td class="px-6 py-4 font-mono text-xs text-blue-600">disabled</td>
                <td class="px-6 py-4 font-mono text-xs">boolean</td>
                <td class="px-6 py-4">false</td>
                <td class="px-6 py-4">Deshabilita la interacción con el campo.</td>
              </tr>
              <tr class="bg-white">
                <td class="px-6 py-4 font-mono text-xs text-blue-600">className</td>
                <td class="px-6 py-4 font-mono text-xs">string</td>
                <td class="px-6 py-4">-</td>
                <td class="px-6 py-4">Clases CSS adicionales para el contenedor principal.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <div>
            <h3 class="text-lg font-medium text-gray-800 mb-3">Batch Mode Props</h3>
            <div class="overflow-x-auto border border-gray-200 rounded-lg">
            <table class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <th class="px-4 py-2">Prop</th>
                    <th class="px-4 py-2">Type</th>
                    <th class="px-4 py-2">Description</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                <tr class="bg-white">
                    <td class="px-4 py-3 font-mono text-xs text-purple-600">name</td>
                    <td class="px-4 py-3 font-mono text-xs">string</td>
                    <td class="px-4 py-3">Nombre del campo en el formulario.</td>
                </tr>
                <tr class="bg-white">
                    <td class="px-4 py-3 font-mono text-xs text-purple-600">register</td>
                    <td class="px-4 py-3 font-mono text-xs">UseFormRegister</td>
                    <td class="px-4 py-3">Función register de react-hook-form.</td>
                </tr>
                <tr class="bg-white">
                    <td class="px-4 py-3 font-mono text-xs text-purple-600">error</td>
                    <td class="px-4 py-3 font-mono text-xs">FieldError</td>
                    <td class="px-4 py-3">Objeto de error para mostrar mensajes de validación.</td>
                </tr>
                </tbody>
            </table>
            </div>
        </div>
        
        <div>
            <h3 class="text-lg font-medium text-gray-800 mb-3">Live Mode Props</h3>
            <div class="overflow-x-auto border border-gray-200 rounded-lg">
            <table class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <th class="px-4 py-2">Prop</th>
                    <th class="px-4 py-2">Type</th>
                    <th class="px-4 py-2">Description</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                <tr class="bg-white">
                    <td class="px-4 py-3 font-mono text-xs text-green-600">onSave</td>
                    <td class="px-4 py-3 font-mono text-xs">Promise&lt;void&gt;</td>
                    <td class="px-4 py-3">Función asíncrona llamada tras el debounce.</td>
                </tr>
                <tr class="bg-white">
                    <td class="px-4 py-3 font-mono text-xs text-green-600">initialValue</td>
                    <td class="px-4 py-3 font-mono text-xs">string | number</td>
                    <td class="px-4 py-3">Valor inicial para el estado local.</td>
                </tr>
                <tr class="bg-white">
                    <td class="px-4 py-3 font-mono text-xs text-green-600">debounceTime</td>
                    <td class="px-4 py-3 font-mono text-xs">number</td>
                    <td class="px-4 py-3">Tiempo de espera en ms (default: 1000).</td>
                </tr>
                </tbody>
            </table>
            </div>
        </div>
      </div>

      <div>
        <h3 class="text-lg font-medium text-gray-800 mb-3">Component Specific Props (Input)</h3>
        <div class="overflow-x-auto border border-gray-200 rounded-lg">
          <table class="w-full text-sm text-left text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
              <tr>
                <th class="px-6 py-3">Prop</th>
                <th class="px-6 py-3">Type</th>
                <th class="px-6 py-3">Default</th>
                <th class="px-6 py-3">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr class="bg-white">
                <td class="px-6 py-4 font-mono text-xs text-blue-600">type</td>
                <td class="px-6 py-4 font-mono text-xs">'text' | 'email' | 'password'</td>
                <td class="px-6 py-4">'text'</td>
                <td class="px-6 py-4">Tipo de input HTML estándar.</td>
              </tr>
              <tr class="bg-white">
                <td class="px-6 py-4 font-mono text-xs text-blue-600">placeholder</td>
                <td class="px-6 py-4 font-mono text-xs">string</td>
                <td class="px-6 py-4">-</td>
                <td class="px-6 py-4">Texto de ayuda (ghost text).</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </div>
</LayoutDS>
