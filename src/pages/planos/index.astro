---
import Layout from '@layouts/Layout.astro';
import Scene from '@components/3d/core/Scene.jsx';
---

<Layout title="Plano Virtual 3D | Revalora">
  <main class="h-screen w-full overflow-hidden bg-gray-900 relative">
    <div class="absolute top-0 left-0 w-full h-full z-0">
      <Scene client:only="react" />
    </div>
    
    {/* Header flotante */}
    <div class="absolute top-4 left-4 z-10 pointer-events-none">
      <h1 class="text-2xl font-bold text-white drop-shadow-md">Recorrido Virtual Planta de economía circular de la CEDA</h1>
      <p class="text-gray-300 text-sm drop-shadow-md">Visualización interactiva de la planta</p>
    </div>
  </main>
</Layout>
