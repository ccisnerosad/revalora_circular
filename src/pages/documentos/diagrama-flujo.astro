---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import etapa1 from '@assets/img/etapa1.png';
import etapa2 from '@assets/img/etapa2.png';
import etapa3 from '@assets/img/etapa3.png';
import etapa4 from '@assets/img/etapa4.png';

const steps = [
  {
    id: "I",
    title: "Diagnóstico de residuos y ubicación",
    video: "/etapas/1.mp4",
    image: etapa1,
    scope: [
      "Identificación y cuantificación real de residuos generados en la CEDA.",
      "Análisis por zonas y giros (frutas, verduras, etc.).",
      "Evaluación de estacionalidad y potencial de aprovechamiento.",
      "Selección técnica del terreno para diseño y construcción."
    ],
    result: "Proyecto viable",
    resultDesc: "Base técnica y económica sólida para justificar el sistema."
  },
  {
    id: "II",
    title: "Construcción e instalación",
    video: "/etapas/2.mp4",
    image: etapa2,
    scope: [
      "Diseño del layout funcional de la planta.",
      "Definición del modelo de valorización y de los cinco productos.",
      "Adecuación del terreno.",
      "Instalación de infraestructura base y equipamiento.",
      "Pruebas técnicas en vacío (sin residuos)."
    ],
    result: "Planta lista",
    resultDesc: "Infraestructura y equipos instalados y operables."
  },
  {
    id: "III",
    title: "Prueba piloto",
    video: "/etapas/3.mp4",
    image: etapa3,
    scope: [
      "Recolección piloto en zonas seleccionadas de la CEDA.",
      "Recepción, pesaje y clasificación piloto.",
      "Operación real en escala controlada.",
      "Obtención piloto de los cinco productos.",
      "Evaluación técnica, operativa, sanitaria, normativa y económica."
    ],
    result: "Sistema validado",
    resultDesc: "Decisión formal de ajuste y escalamiento."
  },
  {
    id: "IV",
    title: "Operación continua",
    video: "/etapas/4.mp4",
    image: etapa4,
    scope: [
      "Recolección diaria en toda la CEDA.",
      "Recepción y clasificación permanente.",
      "Producción continua de los cinco productos.",
      "Salidas controladas y trazables.",
      "Monitoreo de indicadores y mejora continua."
    ],
    result: "Sistema vivo",
    resultDesc: "Operación estable, adaptable y escalable."
  }
];
---

<Layout title="Etapas del Sistema - Diagrama de Flujo" heroDescription="Evolución Estratégica del Sistema CEDA Circular®">
  
  <!-- Pinned Section for Immersive Storytelling -->
  <section id="immersive-stages" class="relative h-screen w-full overflow-hidden bg-black">
    
    <!-- Navigation Dots (Fixed on screen) -->
    <div class="absolute right-6 lg:right-8 top-1/2 -translate-y-1/2 z-50 flex flex-col gap-6">
        {steps.map((_, index) => (
            <button 
                class="nav-dot w-3 h-3 lg:w-4 lg:h-4 rounded-full bg-white/20 hover:bg-white transition-all duration-500 border border-white/10 data-[active=true]:bg-brand-500 data-[active=true]:scale-150 data-[active=true]:border-brand-400 shadow-[0_0_15px_rgba(0,0,0,0.5)]"
                data-index={index}
                aria-label={`Ir a etapa ${index + 1}`}
            ></button>
        ))}
    </div>

    <!-- Slides Container -->
    <div class="slides-container h-full w-full relative">
        {steps.map((step, index) => (
            <div class="stage-slide absolute inset-0 w-full h-full overflow-hidden" style="z-index: 0;">
                
                <!-- Background Video Container -->
                <div class="absolute inset-0 z-0">
                    <div class="absolute inset-0 bg-black/60 z-10"></div> <!-- Overlay más oscuro para contraste -->
                    <div class="absolute inset-0 bg-linear-to-t from-black via-transparent to-black/40 z-10"></div>
                    <video 
                        class="w-full h-full object-cover scale-105 pointer-events-none"
                        autoplay 
                        muted 
                        loop 
                        playsinline
                        webkit-playsinline
                        preload="auto"
                        disablepictureinpicture
                        controlslist="nodownload nofullscreen noremoteplayback"
                    >
                        <source src={step.video} type="video/mp4" />
                    </video>
                </div>

                <!-- Content Container -->
                <div class="relative z-20 h-full w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-center">
                    
                    <!-- Giant Background Number (Visual Anchor) -->
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-black text-[30vh] lg:text-[50vh] leading-none text-white opacity-[0.04] select-none pointer-events-none z-0 font-mono tracking-tighter">
                        {step.id}
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 w-full items-center relative z-10">
                        
                        <!-- Text Content -->
                        <div class="col-span-1 lg:col-span-8 slide-content opacity-0 translate-y-12">
                            
                            <!-- Header Group -->
                            <div class="mb-4 lg:mb-6">
                                <!-- Badge Etapa - Compact & Integrated -->
                                <div class="inline-flex items-center gap-2 mb-2 lg:mb-3 bg-brand-900/40 backdrop-blur-md border border-brand-500/30 rounded-full px-3 py-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
                                    <span class="text-xs font-bold text-brand-100 tracking-widest uppercase">Etapa {step.id}</span>
                                </div>
                                
                                <h2 class="text-3xl sm:text-4xl lg:text-6xl font-bold text-white leading-tight drop-shadow-lg">
                                    {step.title}
                                </h2>
                            </div>

                            <!-- Main Card - Compact Layout -->
                            <div class="glass-panel-dark rounded-xl p-5 lg:p-8 border-l-4 border-brand-500 backdrop-blur-xl bg-black/50 shadow-2xl">
                                
                                <!-- Scope List -->
                                <div class="mb-5 lg:mb-6">
                                    <h3 class="text-brand-400 font-bold uppercase tracking-widest text-[10px] lg:text-xs mb-3 flex items-center gap-2">
                                        <svg class="w-3 h-3 lg:w-4 lg:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                                        Alcance Estratégico
                                    </h3>
                                    <ul class="space-y-2">
                                        {step.scope.map((item) => (
                                            <li class="flex items-start text-gray-200 text-sm sm:text-base font-light leading-snug">
                                                <span class="w-1 h-1 lg:w-1.5 lg:h-1.5 rounded-full bg-brand-500 mt-1.5 lg:mt-2 mr-2 shrink-0"></span>
                                                <span>{item}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>

                                <!-- Result Section - Integrated Footer -->
                                <div class="pt-4 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-6">
                                    <div class="shrink-0 bg-brand-900/30 rounded-lg px-3 py-2 border border-brand-500/20">
                                        <span class="block text-[10px] uppercase tracking-widest text-brand-300 mb-0.5">Resultado Clave</span>
                                        <span class="block text-lg sm:text-xl font-bold text-white">{step.result}</span>
                                    </div>
                                    <p class="text-gray-400 text-xs sm:text-sm italic leading-tight max-w-md">
                                        "{step.resultDesc}"
                                    </p>
                                </div>
                            </div>

                        </div>

                        <!-- Empty column / Visual Balance -->
                        <div class="hidden lg:block lg:col-span-4"></div>
                    </div>
                </div>
            </div>
        ))}
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 animate-bounce text-white/70 flex flex-col items-center gap-2 pointer-events-none">
        <span class="text-[10px] uppercase tracking-[0.3em] font-light">Desliza para explorar</span>
        <svg class="w-5 h-5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
    </div>
  </section>

  <!-- Synthesis Section (Original Diagram) -->
  <section class="bg-gray-50 py-24 px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-7xl mx-auto">
      
      <div class="text-center mb-16 header-anim">
        <span class="text-brand-600 font-bold tracking-wider uppercase text-sm">Conclusión</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">Síntesis del Flujo Estratégico</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Vista general del proceso completo para garantizar la viabilidad y escalabilidad.
        </p>
      </div>

      <!-- Flow Container -->
      <div class="relative">
        <!-- Connecting Line (Desktop) -->
        <div class="hidden lg:block absolute top-1/2 left-0 w-full h-2 bg-gray-200 -translate-y-1/2 z-0 rounded-full">
           <div class="h-full bg-linear-to-r from-brand-500 to-accent-500 w-0 rounded-full progress-line"></div>
        </div>

        <!-- Connecting Line (Mobile) -->
        <div class="lg:hidden absolute left-8 top-0 w-2 h-full bg-gray-200 z-0 rounded-full">
            <div class="w-full bg-linear-to-b from-brand-500 to-accent-500 h-0 rounded-full progress-line-vertical"></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 relative z-10">
          {steps.map((step) => (
            <div class="step-card opacity-0 translate-y-12 relative group">
              
              <!-- Step Number Badge -->
              <div class="absolute left-0 lg:left-1/2 lg:-top-6 lg:-translate-x-1/2 w-12 h-12 rounded-full bg-white border-4 border-brand-500 flex items-center justify-center z-20 shadow-lg group-hover:scale-110 transition-transform duration-300">
                <span class="font-bold text-brand-700">{step.id}</span>
              </div>

              <!-- Card Content -->
              <div class="bg-white rounded-2xl shadow-xl h-full border border-gray-100 hover:border-brand-300 transition-colors duration-300 flex flex-col ml-6 lg:ml-0 lg:mt-6 overflow-hidden group">
                
                <!-- Image Header -->
                <div class="h-48 overflow-hidden relative shrink-0">
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent z-10"></div>
                    <Image src={step.image} alt={step.title} class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
                </div>

                <!-- Result Content -->
                <div class="bg-brand-50 p-5 grow flex flex-col justify-center border-t border-gray-100">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-brand-800 uppercase tracking-wider">Resultado Clave</span>
                        <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <p class="font-bold text-brand-700 text-lg mb-1">{step.result}</p>
                    <p class="text-xs text-brand-600/80 leading-tight">{step.resultDesc}</p>
                </div>

              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // --- Immersive Section Logic ---
  const initImmersive = () => {
    const slides: HTMLElement[] = gsap.utils.toArray('.stage-slide');
    const dots = document.querySelectorAll('.nav-dot');
    
    if (slides.length === 0) return;

    // Unified scroll duration for consistent experience (Same as Desktop)
    const scrollDuration = (slides.length * 100) + "%";

    // Pin the section
    const st = ScrollTrigger.create({
        trigger: "#immersive-stages",
        start: "top top",
        end: "+=" + scrollDuration, 
        pin: true,
        scrub: 0.5, 
        snap: {
            snapTo: 1 / (slides.length - 1),
            duration: { min: 0.5, max: 1.0 },
            delay: 0.0, 
            ease: "power3.inOut"
        },
        onUpdate: (self) => {
            // Calculate current slide index based on scroll progress
            const progress = self.progress;
            const total = slides.length;
            let index = Math.round(progress * (total - 1));
            
            // Update dots
            dots.forEach((dot, i) => {
                if (i === index) {
                    dot.setAttribute('data-active', 'true');
                } else {
                    dot.removeAttribute('data-active');
                }
            });
        }
    });

    // Add click listeners to dots (Native Smooth Scroll)
    dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
            const progress = i / (slides.length - 1);
            const scrollPos = st.start + (st.end - st.start) * progress;
            window.scrollTo({
                top: scrollPos,
                behavior: 'smooth'
            });
        });
    });

    // Animate slides with Clip Path & Zoom Effect
    const masterTl = gsap.timeline({
        scrollTrigger: {
            trigger: "#immersive-stages",
            start: "top top",
            end: "+=" + scrollDuration,
            scrub: 0.5,
        }
    });

    slides.forEach((slide, i) => {
        const content = slide.querySelector('.slide-content');
        const video = slide.querySelector('video');
        
        // Initial state setup
        if (i === 0) {
             gsap.set(slide, { clipPath: "circle(150% at 50% 50%)", zIndex: 10 });
             gsap.set(content, { y: 0, opacity: 1 });
             gsap.set(video, { scale: 1.05 });
        } else {
             gsap.set(slide, { clipPath: "circle(0% at 50% 50%)", zIndex: i + 10 }); // Start closed
             gsap.set(content, { y: 100, opacity: 0 });
             gsap.set(video, { scale: 1.2 }); // Start zoomed in
        }

        if (i === 0) return; // First slide is already visible
        
        // Transition Logic
        const duration = 10;
        const startTime = (i - 1) * duration;

        // 1. Reveal new slide with Clip Path (Circle Expand)
        masterTl.to(slide, { 
            clipPath: "circle(150% at 50% 50%)", 
            duration: duration,
            ease: "none" // Linear ease for smoother scrubbing
        }, startTime);

        // 2. Animate Content Entry (Parallax + Fade)
        masterTl.to(content, { 
            y: 0, 
            opacity: 1, 
            duration: duration * 0.6,
            ease: "power2.out"
        }, startTime + (duration * 0.2));

        // 3. Video Zoom Out (Focus effect)
        masterTl.to(video, {
            scale: 1.05,
            duration: duration,
            ease: "none"
        }, startTime);

        // 4. Previous Slide Exit (Parallax only, NO DARKENING)
        if (i > 0) {
            const prevSlide = slides[i-1];
            const prevContent = prevSlide.querySelector('.slide-content');
            
            // Only animate content out
            masterTl.to(prevContent, {
                y: -50,
                opacity: 0,
                duration: duration * 0.4
            }, startTime);
        }
    });
  };


  // --- Synthesis Section Logic ---
  const initSynthesis = () => {
    const isMobile = window.innerWidth < 1024;

    // Header Animation
    gsap.to(".header-anim", {
      scrollTrigger: { trigger: ".header-anim", start: "top 80%" },
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: "power3.out"
    });

    if (isMobile) {
        // Mobile: Individual animations for each card as they appear
        const cards = gsap.utils.toArray(".step-card");
        cards.forEach((card: any, i) => {
            gsap.fromTo(card, 
                { opacity: 0, y: 50, scale: 0.95 },
                {
                    scrollTrigger: {
                        trigger: card,
                        start: "top 85%",
                        toggleActions: "play none none reverse"
                    },
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 0.6,
                    ease: "back.out(1.2)"
                }
            );
        });
        
        // Mobile Line Animation - Scrubbed
        gsap.to(".progress-line-vertical", {
            scrollTrigger: { 
                trigger: ".step-card", 
                start: "top 80%", 
                end: "bottom 80%", 
                scrub: 1 
            },
            height: "100%",
            ease: "none"
        });

    } else {
        // Desktop: Staggered timeline
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: ".step-card", 
                start: "top 75%",
            }
        });

        tl.to(".step-card", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.2,
            ease: "back.out(1.7)"
        });

        // Desktop Line Animation
        gsap.to(".progress-line", {
            scrollTrigger: { trigger: ".step-card", start: "top 75%" },
            width: "100%",
            duration: 1.5,
            ease: "power2.inOut",
            delay: 0.5
        });
    }
  };

  // Run
  const run = () => {
      // Force video autoplay on mobile
      const videos = document.querySelectorAll('video');
      videos.forEach(video => {
          video.muted = true;
          video.play().catch((e) => console.warn("Video autoplay blocked:", e));
      });

      initImmersive();
      initSynthesis();
  };

  run();
  document.addEventListener('astro:page-load', run);
</script>
