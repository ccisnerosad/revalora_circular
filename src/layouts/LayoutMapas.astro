---
import '@styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

const navItems = [
  { label: 'Modelo 1200m²', href: '/mapas/1200' },
  { label: 'Modelo 3000m²', href: '/mapas/3000' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="CEDA - Revalora Circular" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
	</head>
	<body class="bg-gray-900 text-white font-sans antialiased overflow-hidden h-screen w-screen">
        
        <slot />

        {/* Navegación Sutil Flotante */}
        <nav class="absolute top-6 left-1/2 transform -translate-x-1/2 z-50">
            <div class="bg-black/40 backdrop-blur-md border border-white/10 rounded-full px-6 py-2 flex items-center gap-6 shadow-lg transition-all hover:bg-black/60">
                <a href="/modulos" class="text-white/70 hover:text-white transition-colors text-sm font-medium flex items-center gap-2">
                    <span class="text-lg">🏠</span>
                    <span class="hidden sm:inline">Inicio</span>
                </a>
                <div class="w-px h-4 bg-white/20"></div>
                {navItems.map(item => (
                    <a 
                        href={item.href} 
                        class={`text-sm font-medium transition-colors ${currentPath === item.href ? 'text-yellow-400' : 'text-white/70 hover:text-white'}`}
                    >
                        {item.label}
                    </a>
                ))}
            </div>
        </nav>

	</body>
</html>
