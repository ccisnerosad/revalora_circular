---
import '@styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const menuItems = [
  {
    category: "Guías",
    items: [
      { label: "Introducción & Arquitectura", href: "/design_system" },
    ]
  },
  {
    category: "Componentes (Atoms)",
    items: [
      { label: "Input", href: "/design_system/components/input" },
      { label: "TextArea", href: "/design_system/components/textarea" },
    ]
  },
  {
    category: "Feedback (Molecules)",
    items: [
      { label: "Toasts", href: "/design_system/components/toast" },
    ]
  }
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Design System - Revalora Circular" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <title>{title} | Design System</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased h-screen flex flex-col md:flex-row overflow-hidden">
    
    <!-- Mobile Header -->
    <header class="md:hidden bg-slate-900 text-white p-4 flex justify-between items-center z-20 shrink-0">
      <div class="font-bold">Design System</div>
      <button id="menu-toggle" class="text-slate-300 hover:text-white focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </header>

    <!-- Sidebar -->
    <aside id="sidebar" class="
      fixed inset-0 z-40 bg-slate-900 w-64 transform -translate-x-full transition-transform duration-300 ease-in-out
      md:translate-x-0 md:static md:shrink-0 md:flex md:flex-col md:border-r md:border-slate-800
      pt-16 md:pt-0
    ">
      <!-- Overlay text for mobile close -->
      <button id="menu-close" class="absolute top-4 right-4 text-slate-400 md:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="p-6 border-b border-slate-800 hidden md:block">
        <h1 class="text-xl font-bold text-white tracking-tight">Grupo Asemh</h1>
        <p class="text-xs text-slate-500 mt-1">v1.0.0 • Design System</p>
      </div>

      <nav class="flex-1 overflow-y-auto p-4 space-y-8">
        {menuItems.map((section) => (
          <div>
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 px-2">
              {section.category}
            </h3>
            <ul class="space-y-1">
              {section.items.map((item) => {
                const isActive = currentPath === item.href || (item.href !== '/design_system' && currentPath.startsWith(item.href));
                return (
                  <li>
                    <a 
                      href={item.href}
                      class:list={[
                        "block px-2 py-1.5 rounded-md text-sm transition-colors",
                        isActive 
                          ? "bg-blue-600 text-white font-medium" 
                          : "hover:bg-slate-800 hover:text-white"
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>

      <div class="p-4 border-t border-slate-800">
        <a href="/" class="flex items-center gap-2 text-sm text-slate-400 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver a la App
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto bg-white">
      <div class="max-w-5xl mx-auto py-10 px-8">
        <slot />
      </div>
    </main>

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const menuClose = document.getElementById('menu-close');
      const sidebar = document.getElementById('sidebar');

      function toggleMenu() {
        sidebar?.classList.toggle('-translate-x-full');
      }

      menuToggle?.addEventListener('click', toggleMenu);
      menuClose?.addEventListener('click', toggleMenu);
    </script>
  </body>
</html>
